{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "web",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/template",
      "destination": "/"
    },
    {
      "source": "/methodology",
      "destination": "/about/methodology",
      "permanent": true
    },
    {
      "source": "/privacy",
      "destination": "/about/privacy",
      "permanent": true
    }
  ]
}
